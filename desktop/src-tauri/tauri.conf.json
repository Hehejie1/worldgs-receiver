{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldGS",
  "version": "0.0.1",
  "identifier": "cn.worldgs.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorldGS",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/receiver_sidecar"],
    "resources": {
      "../../build/ms-playwright": "playwright-browsers"
    }
  }
}
